{
  "name": "@squish/desktop",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-electron/main.js && node -e \"import('node:fs').then(({copyFileSync})=>copyFileSync('electron/preload.cjs','dist-electron/preload.cjs'))\"",
    "build:native": "node scripts/copy-native-binaries.mjs",
    "dev": "npm run build:electron && npm run build:native && concurrently -k \"vite --port 3000\" \"wait-on http://localhost:3000 && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .\"",
    "build": "vite build && npm run build:electron && npm run build:native",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && cross-env APPLE_KEYCHAIN_PROFILE=squik-notary electron-builder --mac dmg",
    "dist:mac:arm64": "cross-env SQUIK_TARGET_ARCH=arm64 npm run build && cross-env APPLE_KEYCHAIN_PROFILE=squik-notary electron-builder --mac dmg --arm64",
    "dist:mac:x64": "cross-env SQUIK_TARGET_ARCH=x64 npm run build && cross-env APPLE_KEYCHAIN_PROFILE=squik-notary electron-builder --mac dmg --x64",
    "dist:win": "cross-env SQUIK_TARGET_PLATFORM=win32 SQUIK_TARGET_ARCH=x64 npm run build && electron-builder --win --x64",
    "dist:portable": "cross-env SQUIK_TARGET_PLATFORM=win32 SQUIK_TARGET_ARCH=x64 npm run build && electron-builder --win portable --x64",
    "clean": "node -e \"const fs=require('fs');['dist','dist-electron','release'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "35.7.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "gsap": "^3.15.0",
    "i18next": "^24.2.3",
    "react-i18next": "^15.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^8.0.3"
  },
  "description": "Squik — compress and merge academic videos under 200 MB",
  "author": "Squik",
  "build": {
    "appId": "com.kunduz.squish",
    "productName": "Squik",
    "electronVersion": "35.7.5",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ],
      "icon": "build-resources/icon.png",
      "identity": "Ali Unal (VMDH25KKNR)",
      "extraResources": [
        {
          "from": "build-resources/bin",
          "to": "bin",
          "filter": [
            "ffmpeg",
            "ffprobe"
          ]
        }
      ]
    },
    "win": {
      "icon": "build-resources/icon.png",
      "signExecutable": false,
      "extraResources": [
        {
          "from": "build-resources/bin/win32-x64",
          "to": "bin"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Squik-${version}-win-${arch}-portable.${ext}"
    },
    "dmg": {
      "artifactName": "Squik-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "Squik-${version}-win-${arch}-setup.${ext}",
      "shortcutName": "Squik",
      "uninstallDisplayName": "Squik"
    }
  }
}
